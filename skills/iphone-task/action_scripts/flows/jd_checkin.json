{
  "intent": "京东每日签到领京豆",
  "device": "anchors written against 京东 App, 简体中文, iOS 18. Not yet replayed.",
  "anchor_notes": [
    "京东把签到入口放在「我的」页顶部的京豆/签到卡片，改版频繁。",
    "如果 tap_text 报 not_found，用 screen_text.py --grep 签 看当前真实文案，改这里的 any_of 即可，不要改坐标——这里没有坐标。"
  ],
  "steps": [
    {
      "action": "open_app",
      "app": "${APP}",
      "settle": 1.5
    },
    {
      "action": "assert",
      "type": "screen_any_of",
      "value": ["京东", "首页", "我的", "购物车"],
      "retries": 8,
      "interval": 2.0
    },
    {
      "action": "tap_text",
      "any_of": ["我的"],
      "prefer": "bottom",
      "retries": 4
    },
    {
      "action": "assert",
      "type": "screen_any_of",
      "value": ["京豆", "签到", "我的订单", "待收货"],
      "retries": 6
    },
    {
      "action": "tap_text",
      "any_of": ["签到领京豆", "签到有礼", "签到", "京豆"],
      "exclude": ["已签到", "已连续"],
      "prefer": "first",
      "scroll": "down",
      "scroll_max": 2,
      "retries": 5,
      "skip_if": {
        "type": "screen_any_of",
        "value": ["已签到", "明日可领", "已连续签到"]
      }
    },
    {
      "action": "assert",
      "type": "screen_any_of",
      "value": ["京豆", "签到", "领取", "连续"],
      "retries": 6
    },
    {
      "action": "tap_text",
      "any_of": ["立即签到", "签到领京豆", "领京豆", "签到"],
      "exclude": ["已签到", "已领取", "明日"],
      "prefer": "largest",
      "retries": 4,
      "optional": true,
      "skip_if": {
        "type": "screen_any_of",
        "value": ["已签到", "已领取", "明日再来", "明天再来"]
      }
    },
    {
      "action": "sleep",
      "seconds": 3
    }
  ]
}
